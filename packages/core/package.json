{
  "name": "toolairlock",
  "version": "0.1.0",
  "description": "Nothing writes without passing through the airlock. Risk-classified tools, two-phase writes and human confirmation for in-app LLM agents.",
  "keywords": [
    "llm",
    "agent",
    "tool-calling",
    "human-in-the-loop",
    "guardrails",
    "copilot"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist",
    "testing"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "dayjs": "^1.11.10",
    "fuse.js": "^6.4.3"
  },
  "peerDependencies": {
    "@sinclair/typebox": ">=0.31.0"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.31.30",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  }
}
