{
  "name": "@toolairlock/executor",
  "version": "0.1.0",
  "description": "Generic DOM operation primitives for toolairlock. Lets an agent act on any page without declaring per-capability tools.",
  "keywords": [
    "toolairlock",
    "gui-agent",
    "dom",
    "accessibility"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "toolairlock": "^0.1.0"
  },
  "devDependencies": {
    "toolairlock": "^0.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
