{
  "name": "@wandkit/ui",
  "version": "0.1.0",
  "description": "Confirmation card and interaction mask for Wandkit. Framework-agnostic Web Components.",
  "keywords": [
    "wandkit",
    "web-components",
    "human-in-the-loop",
    "confirmation"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "wandkit": "^0.1.0"
  },
  "devDependencies": {
    "wandkit": "^0.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
