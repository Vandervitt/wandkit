{
  "name": "@toolairlock/chat",
  "version": "0.1.0",
  "description": "Headless conversation state plus optional chat panel for toolairlock. Speaks the OpenAI chat-completions wire format, with or without the core runtime.",
  "keywords": [
    "toolairlock",
    "openai",
    "chat",
    "web-components",
    "headless"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/ui.js",
    "./dist/ui.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "require": "./dist/bridge.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "ui": [
        "./dist/ui.d.ts"
      ],
      "bridge": [
        "./dist/bridge.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "ui",
    "bridge"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@toolairlock/ui": "^0.1.0",
    "toolairlock": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "toolairlock": {
      "optional": true
    },
    "@toolairlock/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@toolairlock/ui": "^0.1.0",
    "toolairlock": "^0.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
