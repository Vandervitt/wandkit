# 复制为 .env 后填入。.env 已在 .gitignore 中，不会进版本库。
#
# 任选一家 OpenAI 兼容的服务商。推荐智谱 GLM-4-Flash：永久免费、不限量、工具调用稳定。

# ── 智谱 GLM（推荐，申请：https://www.bigmodel.cn/）──────────────────
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_API_KEY=

# ── 硅基流动（申请：https://cloud.siliconflow.cn/）──────────────────
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3-8B

# ── 阿里百炼（申请：https://bailian.console.aliyun.com/）────────────
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ── DeepSeek（申请：https://platform.deepseek.com/）─────────────────
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
