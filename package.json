{
  "name": "toolairlock-workspace",
  "private": true,
  "description": "Monorepo for toolairlock — write-operation governance for in-app LLM agents.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run test && npm run typecheck && npm run build",
    "example": "vite-node examples/01-fake-llm.ts",
    "example:llm": "vite-node examples/02-real-llm.ts",
    "example:page": "vite-node examples/03-page-executor.ts",
    "example:chat": "vite-node examples/04-chat-standalone.ts",
    "example:interceptor": "vite-node examples/05-interceptor.ts",
    "example:page-prompt": "vite-node examples/06-page-agent-prompt.ts",
    "llm-proxy": "node examples/llm-proxy.mjs"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.31.30",
    "@types/node": "^26.1.1",
    "jsdom": "^29.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite-node": "^1.6.1",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
